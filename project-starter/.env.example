# Copy this file to .env for local runs. Never commit .env.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Your Groq key, from https://console.groq.com/keys
GROQ_API_KEY=
# A small, fast model. See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant

# Leave empty to use a local SQLite file. On Vercel, Neon sets this for you.
DATABASE_URL=
